# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
MONGO_URL=mongodb+srv://<username>:<PASSWORD>@cluster0.mongodb.net/natours?retryWrites=true&w=majority
PASSWORD=your_mongodb_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_make_it_very_long_and_secure
JWT_EXPIRE_IN=90d
JWT_COOKIE_EXPIRE_IN=90

# Email Configuration (for development)
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_USERNAME=test@example.com
EMAIL_PASSWORD=test123
EMAIL_FROM=noreply@natours.com

# Gmail Configuration (for production)
GEMAIL_USERNAME=your_gmail@gmail.com
GMAIL_PASSWORD=your_gmail_app_password

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Mapbox Configuration
MAPBOX_TOKEN=pk.your_mapbox_token_here

# File Upload Configuration
MAX_FILE_SIZE=10000000 